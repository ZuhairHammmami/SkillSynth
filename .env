# وضع التشغيل: dev = تطوير | prod = نشر
MODE=dev

# إعدادات الخادم (هذه اختيارية حاليًا، ولكنها مفيدة للمستقبل)
HOST=127.0.0.1
PORT=8000

# رابط الاتصال بقاعدة بيانات PostgreSQL من Supabase
# تأكد من أن كلمة المرور صحيحة
DATABASE_URL="postgresql://postgres:zuhairnour1@db.pvhykpqjwftqqmzxaynx.supabase.co:5432/postgres"

SENDGRID_API_KEY="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"

# ============================================================================
# Phase 4.0: Hybrid LLM Provider Configuration
# ============================================================================

# LLM Provider Strategy: "local" | "openai" | "hybrid"
# - local: Use Ollama only (privacy, cost-free)
# - openai: Use OpenAI only
# - hybrid: Try local first, fallback to OpenAI if unavailable (RECOMMENDED)
LLM_PROVIDER=hybrid

# Local LLM Configuration (Ollama)
# Note: Ollama must be running locally: https://ollama.ai
# Install: curl https://ollama.ai/install.sh | sh
# Run: ollama serve
# Pull model: ollama pull mistral (or llama2, neural-chat, etc.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Set to true to fallback to OpenAI if Ollama is unavailable
OLLAMA_FALLBACK_TO_OPENAI=true

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# GitHub Integration (for project submission validation)
# Optional: Add token for higher API rate limits (60 req/min vs 10 req/min)
# Get token from: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=ghp_your-token-here

# ============================================================================
# Alternative Provider Configuration (Development/Testing)
# ============================================================================

# Force a specific provider for debugging:
# - undefined: Use LLM_PROVIDER setting (default)
# - "local": Force local provider only
# - "openai": Force OpenAI only
# LLM_FORCE_PROVIDER=undefined

# ============================================================================
# Cost Tracking & Monitoring
# ============================================================================
# Enable cost tracking for LLM API calls
TRACK_LLM_COSTS=true

# Log verbose debug information about LLM provider selection
DEBUG_LLM_PROVIDER=false


# ============================================================================
# Phase 4.5: Vector Search & Intelligent Discovery Configuration
# ============================================================================

# Vector Search Settings
# Enable vector search (requires pgvector enabled in Supabase)
ENABLE_VECTOR_SEARCH=true

# Embedding generation strategy: "openai" | "local" | "hybrid"
# - openai: Use OpenAI text-embedding-3-small (1536 dims, ~0.02 per 1M tokens)
# - local: Use local sentence-transformers service (requires running locally)
# - hybrid: Try local first, fallback to OpenAI (RECOMMENDED)
EMBEDDING_PROVIDER=hybrid

# Local Embedding Service Configuration
# If using local embeddings, ensure sentence-transformers is running
# pip install sentence-transformers flask
# python -m flask run --host=localhost --port=8000
EMBEDDING_SERVICE_URL=http://localhost:8000

# Vector Search Similarity Threshold
# Minimum cosine similarity score for results (0-1)
# Higher = more strict, only very similar results
# Default: 0.5 (moderate relevance)
VECTOR_SEARCH_MIN_SIMILARITY=0.5

# Maximum vector search results
VECTOR_SEARCH_MAX_RESULTS=20

# Debug flags
DEBUG_VECTOR_SEARCH=false

# Admin API Token (for batch operations like embedding generation)
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=your-admin-token-here

