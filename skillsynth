#!/usr/bin/env bash
# skillsynth — root shim: prefer the venv entrypoint, fall back to source tree.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$DIR/.venv/bin/skillsynth" ]]; then
  exec "$DIR/.venv/bin/skillsynth" "$@"
fi
exec env PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}" python -m backend.cli "$@"
