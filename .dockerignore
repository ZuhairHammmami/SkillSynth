# ============================================================================
# Docker build context — ignore unnecessary files
# ============================================================================

# Version control
.git/
.gitignore
.gitattributes

# Environment (injected at runtime)
.env
.env.local
.env.*.local
.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node / SvelteKit
node_modules/
.svelte-kit/
build/
.next/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation
docs/
*.md

# Reports
PHASE_A/
PHASE_B/

# Tools
tools/

# Tests
tests/

# Scripts (not needed in container)
start.sh
seed_v3.py
seed_v4.py

# Frontend specific (not needed for backend build)
src/frontend/node_modules/
src/frontend/.svelte-kit/
src/frontend/build/
src/frontend/.next/
src/admin-app/node_modules/
src/admin-app/.svelte-kit/
src/admin-app/build/
src/admin-app/.next/

# Migrations source
src/migrations/001_final_schema*.sql

# Backups
*.backup
*.bak
