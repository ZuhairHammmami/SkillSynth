{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sqlite": {
      "enabled": true,
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db",
        "/media/zuhair/Extra/SkillSynth/skillsynth.db"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },

    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"]
    },
    "supabase": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=pvhykpqjwftqqmzxaynx",
    }
  }
}
