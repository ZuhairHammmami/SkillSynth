# ============================================================================
# SkillSynth Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
# ============================================================================

# --- Application Mode ---
# dev = SQLite (local), prod = PostgreSQL (Supabase)
MODE=dev

# Server host/port (backend)
HOST=127.0.0.1
PORT=8000

# --- Database ---
# PostgreSQL connection string (only used when MODE=prod)
# In dev mode, skillsynth.db (SQLite) is used automatically.
DATABASE_URL="postgresql://postgres:YOUR_PROD_PASSWORD@db.your-project.supabase.co:5432/postgres"

# Connection pool settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Authentication ---
# JWT secret key - CHANGE THIS in production!
# Generate: openssl rand -hex 32
SECRET_KEY="change-me-to-a-random-secret-in-production"

# Admin user auto-creation on startup
ADMIN_EMAIL=admin@skillsynth.io
# Generate: openssl rand -base64 24
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Password pepper (additional layer of password hashing security)
# Generate: openssl rand -hex 16
PASSWORD_PEPPER="change-me-in-production"

# --- Email (SendGrid) ---
# Used for password reset emails (only in production)
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"

# --- Caching / Rate Limiting ---
# Redis URL (only used in production for rate limiting)
REDIS_URL="redis://localhost:6379/0"

# --- LLM Provider Configuration ---
# Strategy: "local" | "openai" | "hybrid"
LLM_PROVIDER=hybrid

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_FALLBACK_TO_OPENAI=true

# OpenAI
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-api-key-here"
OPENAI_MODEL=gpt-4

# GitHub Integration (optional, for higher API rate limits)
# https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your-token-here"

# LLM Cost tracking
TRACK_LLM_COSTS=true
DEBUG_LLM_PROVIDER=false

# --- Vector Search Configuration ---
ENABLE_VECTOR_SEARCH=true
EMBEDDING_PROVIDER=hybrid
EMBEDDING_SERVICE_URL=http://localhost:8000
VECTOR_SEARCH_MIN_SIMILARITY=0.5
VECTOR_SEARCH_MAX_RESULTS=20
DEBUG_VECTOR_SEARCH=false

# Admin API token (for batch operations)
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN="your-admin-token-here"

# ============================================================================
# Frontend Environment Variables
# ============================================================================
# These go in src/frontend/.env.local (NOT in .env)

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
