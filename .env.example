# ============================================================================
# SkillSynth Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
#
# SQLite (dev) is the default and needs no extra services.
# Postgres/Supabase is the production option — see the production section below.
# ============================================================================

# --- Application Mode ---
# dev = SQLite (local, zero-config), prod = PostgreSQL (Supabase)
MODE=dev

# Server host/port (backend)
HOST=127.0.0.1
PORT=8000

# --- Database (SQLite — default, used when MODE=dev) ---
# Path to the SQLite database file. Defaults to ./skillsynth.db at the repo root.
# DB_PATH=/abs/path/to/skillsynth.db

# --- Authentication ---
# JWT secret key - CHANGE THIS in production!
# Generate: openssl rand -hex 32
SECRET_KEY="change-me-to-a-random-secret-in-production"

# Admin user auto-creation on startup
ADMIN_EMAIL=admin@skillsynth.io
# Generate: openssl rand -base64 24
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Password pepper (additional layer of password hashing security)
# Generate: openssl rand -hex 16
PASSWORD_PEPPER="change-me-in-production"

# ── SS-AI local model (ADR-015) ──────────────────────────────────────
# Optional local LLM inference. OFF by default; enable with AI_ENABLED=true
# and a compatible model file placed at AI_MODEL_PATH.
AI_ENABLED=false
AI_MODEL_PATH=src/data/Llama-3.2-3B-Instruct-Q6_K.gguf
AI_N_GPU_LAYERS=-1
AI_N_CTX=4096
AI_TEMPERATURE=0.3
AI_REPEAT_PENALTY=1.15
AI_TOP_P=0.95
AI_MAX_NEW_TOKENS=700

# ============================================================================
# PRODUCTION — PostgreSQL / Supabase + SendGrid + Redis
# Only used when MODE=prod
# ============================================================================
# --- Database (PostgreSQL) ---
# DATABASE_URL="postgresql://postgres:YOUR_PROD_PASSWORD@db.your-project.supabase.co:5432/postgres"
# Connection pool settings (PostgreSQL only)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# --- Email (SendGrid) ---
# Used for password reset emails (production only)
# https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"

# --- Caching / Rate Limiting ---
# Redis URL (production only, used for rate limiting)
# REDIS_URL="redis://localhost:6379/0"

# --- GitHub Integration (optional, for higher API rate limits) ---
# GITHUB_TOKEN="ghp_your-token-here"

# ============================================================================
# Frontend Environment Variables
# ============================================================================
# SvelteKit apps read PUBLIC_API_BASE_URL at build time.
# See src/frontend/.env.local and src/admin-app/.env.local.
# PUBLIC_API_BASE_URL=http://localhost:8000/api
